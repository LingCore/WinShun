#pragma code_page(65001)
#include <winver.h>

// The exe icon. Qt gives its windows the icon named IDI_ICON1; MessageWindow
// loads it for the tray icon.
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION QUICKFIND_VERSION_MAJOR,QUICKFIND_VERSION_MINOR,QUICKFIND_VERSION_PATCH,0
 PRODUCTVERSION QUICKFIND_VERSION_MAJOR,QUICKFIND_VERSION_MINOR,QUICKFIND_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "QuickFind"
            VALUE "FileDescription", "快搜 QuickFind"
            VALUE "FileVersion", QUICKFIND_VERSION
            VALUE "InternalName", "QuickFind"
            VALUE "OriginalFilename", "QuickFind.exe"
            VALUE "ProductName", "快搜 QuickFind"
            VALUE "ProductVersion", QUICKFIND_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
