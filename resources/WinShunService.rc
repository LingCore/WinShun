#pragma code_page(65001)
#include <winver.h>

// WinShunService.exe (src/service): the index service, which reads the NTFS
// volumes' master file tables and change journals for a Win顺 that runs
// with the user's normal rights.
// Task Manager shows its description for both of its processes: the index
// service and the key listener it starts in the user's session (--listen-keys).
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINSHUN_VERSION_MAJOR,WINSHUN_VERSION_MINOR,WINSHUN_VERSION_PATCH,0
 PRODUCTVERSION WINSHUN_VERSION_MAJOR,WINSHUN_VERSION_MINOR,WINSHUN_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "WinShun"
            VALUE "FileDescription", "Win顺 后台服务 · WinShun background service"
            VALUE "FileVersion", WINSHUN_VERSION
            VALUE "InternalName", "WinShunService"
            VALUE "OriginalFilename", "WinShunService.exe"
            VALUE "ProductName", "Win顺 · WinShun"
            VALUE "ProductVersion", WINSHUN_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
