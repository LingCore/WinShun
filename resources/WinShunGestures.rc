#pragma code_page(65001)
#include <winver.h>

// WinShunGestures.exe (src/gestures-plugin): the winshun.gestures plugin
// in the plugin library -- mouse gestures (鼠标手势).
IDI_ICON1 ICON "app.ico"

// The few Phosphor icons the cards draw (src/gestures-plugin/icons, rebuilt by
// make-subset.py); Cards.cpp loads them into a private font collection.
PHOSPHOR_GESTURES RCDATA "../src/gestures-plugin/icons/PhosphorGestures.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINSHUN_VERSION_MAJOR,WINSHUN_VERSION_MINOR,WINSHUN_VERSION_PATCH,0
 PRODUCTVERSION WINSHUN_VERSION_MAJOR,WINSHUN_VERSION_MINOR,WINSHUN_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "WinShun"
            VALUE "FileDescription", "Win顺 鼠标手势"
            VALUE "FileVersion", WINSHUN_VERSION
            VALUE "InternalName", "WinShunGestures"
            VALUE "OriginalFilename", "WinShunGestures.exe"
            VALUE "ProductName", "Win顺 · WinShun"
            VALUE "ProductVersion", WINSHUN_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
