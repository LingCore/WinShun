#pragma code_page(65001)
#include <winver.h>

// WinShunBookmarks.exe (src/bookmarks-plugin): the winshun.bookmarks plugin
// in the plugin library -- browser bookmarks (浏览器书签).
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINSHUN_VERSION_MAJOR,WINSHUN_VERSION_MINOR,WINSHUN_VERSION_PATCH,0
 PRODUCTVERSION WINSHUN_VERSION_MAJOR,WINSHUN_VERSION_MINOR,WINSHUN_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "WinShun"
            VALUE "FileDescription", "Win顺 浏览器书签"
            VALUE "FileVersion", WINSHUN_VERSION
            VALUE "InternalName", "WinShunBookmarks"
            VALUE "OriginalFilename", "WinShunBookmarks.exe"
            VALUE "ProductName", "Win顺 · WinShun"
            VALUE "ProductVersion", WINSHUN_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
