# Shared public GitHub file mirrors, used by both the app and build downloads.
set(_winshun_mirror_file "${CMAKE_CURRENT_LIST_DIR}/../resources/downloads/github-mirrors.txt")
file(STRINGS "${_winshun_mirror_file}" WINSHUN_GITHUB_MIRRORS REGEX "^https://")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_winshun_mirror_file}")

function(winshun_configure_mirrors destination)
    list(LENGTH WINSHUN_GITHUB_MIRRORS WINSHUN_MIRROR_COUNT)
    if(WINSHUN_MIRROR_COUNT EQUAL 0)
        message(FATAL_ERROR "The GitHub mirror list is empty")
    endif()
    set(WINSHUN_MIRROR_ENTRIES "")
    foreach(prefix IN LISTS WINSHUN_GITHUB_MIRRORS)
        if(NOT prefix MATCHES "^https://[a-z0-9.-]+/$")
            message(FATAL_ERROR "Invalid GitHub mirror prefix: ${prefix}")
        endif()
        string(APPEND WINSHUN_MIRROR_ENTRIES "    \"${prefix}\",\n")
    endforeach()
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/GitHubMirrors.h.in" "${destination}" @ONLY)
endfunction()

function(winshun_download_sources url result)
    set(sources "")
    # Public files only: never forward API calls, credentials or signed queries.
    if(NOT url MATCHES "[?@#]" AND
       (url MATCHES "^https://github.com/[^/]+/[^/]+/releases/download/[^/]+/.+" OR
        url MATCHES "^https://raw.githubusercontent.com/[^/]+/[^/]+/[^/]+/.+"))
        foreach(prefix IN LISTS WINSHUN_GITHUB_MIRRORS)
            list(APPEND sources "${prefix}${url}")
        endforeach()
    endif()
    list(APPEND sources "${url}")
    list(REMOVE_DUPLICATES sources)
    set(${result} "${sources}" PARENT_SCOPE)
endfunction()

# Kept separate from URL selection so the actual retry/hash path can be tested
# with local files, without a public network dependency.
function(winshun_download_verified destination sha256)
    string(TOLOWER "${sha256}" sha256)
    string(LENGTH "${sha256}" hash_length)
    if(NOT hash_length EQUAL 64 OR NOT sha256 MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "A fixed SHA256 is required to download ${destination}")
    endif()
    if(EXISTS "${destination}")
        file(SHA256 "${destination}" actual)
        if(actual STREQUAL sha256)
            return()
        endif()
    endif()
    get_filename_component(parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    set(partial "${destination}.partial")
    set(failures "")
    foreach(url IN LISTS ARGN)
        file(REMOVE "${partial}")
        file(DOWNLOAD "${url}" "${partial}" STATUS status
            TLS_VERIFY ON TIMEOUT 120 INACTIVITY_TIMEOUT 15)
        list(GET status 0 code)
        if(code EQUAL 0)
            file(SHA256 "${partial}" actual)
            if(actual STREQUAL sha256)
                file(RENAME "${partial}" "${destination}" RESULT renamed)
                if(NOT renamed STREQUAL "0")
                    file(REMOVE "${partial}")
                    message(FATAL_ERROR "Could not save ${destination}: ${renamed}")
                endif()
                return()
            endif()
            set(status "SHA256 mismatch")
        endif()
        string(APPEND failures "\n  ${url}: ${status}")
    endforeach()
    file(REMOVE "${partial}")
    message(FATAL_ERROR "Could not download verified ${destination}:${failures}")
endfunction()

function(winshun_download url destination sha256)
    winshun_download_sources("${url}" sources)
    winshun_download_verified("${destination}" "${sha256}" ${sources})
endfunction()
