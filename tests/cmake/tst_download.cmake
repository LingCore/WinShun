cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/Download.cmake")

if(NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "TEST_DIR is required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
set(origin "https://github.com/a/b/releases/download/v1/a.zip")
winshun_download_sources("${origin}" urls)
list(GET urls 0 first)
list(GET urls 1 second)
list(GET urls 2 last)
if(NOT first STREQUAL "https://gh-proxy.com/${origin}" OR
   NOT second STREQUAL "https://ghfast.top/${origin}" OR NOT last STREQUAL origin)
    message(FATAL_ERROR "Wrong mirror order: ${urls}")
endif()
foreach(url "https://api.github.com/repos/a/b" "${origin}?token=secret" "https://www.modelscope.cn/a")
    winshun_download_sources("${url}" urls)
    if(NOT urls STREQUAL url)
        message(FATAL_ERROR "An API/private/domestic URL was rewritten: ${urls}")
    endif()
endforeach()
file(WRITE "${TEST_DIR}/bad.txt" "bad mirror content")
file(WRITE "${TEST_DIR}/good.txt" "verified payload")
file(SHA256 "${TEST_DIR}/good.txt" hash)
file(REMOVE "${TEST_DIR}/result.txt" "${TEST_DIR}/result.txt.partial")
winshun_download_verified("${TEST_DIR}/result.txt" "${hash}"
    "file://${TEST_DIR}/missing.txt" "file://${TEST_DIR}/bad.txt" "file://${TEST_DIR}/good.txt")
file(SHA256 "${TEST_DIR}/result.txt" actual)
if(NOT actual STREQUAL hash OR EXISTS "${TEST_DIR}/result.txt.partial")
    message(FATAL_ERROR "Bad fallback result or a partial download was left")
endif()
# A verified cache needs no network, even if the sources are now unavailable.
string(TOUPPER "${hash}" uppercase_hash)
winshun_download_verified("${TEST_DIR}/result.txt" "${uppercase_hash}" "file://${TEST_DIR}/missing.txt")
# All failures must preserve an existing file and remove the partial one.
file(WRITE "${TEST_DIR}/previous.txt" "previous version")
file(WRITE "${TEST_DIR}/all-fail.cmake"
    "include(\"${CMAKE_CURRENT_LIST_DIR}/../../cmake/Download.cmake\")\n"
    "winshun_download_verified(\"${TEST_DIR}/previous.txt\" \"${hash}\" \"file://${TEST_DIR}/bad.txt\")\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${TEST_DIR}/all-fail.cmake"
    RESULT_VARIABLE failed OUTPUT_QUIET ERROR_QUIET)
file(READ "${TEST_DIR}/previous.txt" previous)
if(failed EQUAL 0 OR NOT previous STREQUAL "previous version" OR EXISTS "${TEST_DIR}/previous.txt.partial")
    message(FATAL_ERROR "All-source failure did not preserve the old file or clean up")
endif()
message(STATUS "Mirror order, failed/corrupt-source fallback, hash verification and cache reuse passed")
