cmake_minimum_required(VERSION 3.21)

if(NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "TEST_DIR is required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(CMAKE_BINARY_DIR "${TEST_DIR}/${run_id}")
set(fixture "${CMAKE_BINARY_DIR}/fixture")
file(MAKE_DIRECTORY "${fixture}/build/native/include" "${fixture}/runtimes/win-x64/native")
foreach(path build/native/include/onnxruntime_c_api.h build/native/include/onnxruntime_experimental_c_api.inc
        runtimes/win-x64/native/onnxruntime.dll LICENSE ThirdPartyNotices.txt)
    file(WRITE "${fixture}/${path}" "fixture: ${path}")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${CMAKE_BINARY_DIR}/fixture.nupkg" --format=zip
    build runtimes LICENSE ThirdPartyNotices.txt WORKING_DIRECTORY "${fixture}" COMMAND_ERROR_IS_FATAL ANY)

# Use the production setup block, replacing only the network with a NuGet-shaped fixture.
function(winshun_download url destination sha256)
    if(NOT url MATCHES "^https://api[.]nuget[.]org/v3-flatcontainer/microsoft[.]ml[.]onnxruntime/")
        message(FATAL_ERROR "ONNX Runtime must come from the official NuGet feed: ${url}")
    endif()
    string(LENGTH "${sha256}" hash_length)
    if(NOT hash_length EQUAL 64 OR NOT sha256 MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "The NuGet package needs a fixed SHA256")
    endif()
    configure_file("${CMAKE_BINARY_DIR}/fixture.nupkg" "${destination}" COPYONLY)
endfunction()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../../src/app/CMakeLists.txt" app_cmake)
string(FIND "${app_cmake}" "set(ORT_VERSION " start)
string(FIND "${app_cmake}" "add_library(onnxruntime_headers" end)
if(start LESS 0 OR end LESS start)
    message(FATAL_ERROR "ONNX Runtime setup block was not found")
endif()
math(EXPR length "${end} - ${start}")
string(SUBSTRING "${app_cmake}" ${start} ${length} setup)
file(WRITE "${CMAKE_BINARY_DIR}/setup.cmake" "${setup}")
include("${CMAKE_BINARY_DIR}/setup.cmake")
foreach(pair "include/onnxruntime_c_api.h|build/native/include/onnxruntime_c_api.h"
        "include/onnxruntime_experimental_c_api.inc|build/native/include/onnxruntime_experimental_c_api.inc"
        "lib/onnxruntime.dll|runtimes/win-x64/native/onnxruntime.dll" "LICENSE|LICENSE" "ThirdPartyNotices.txt|ThirdPartyNotices.txt")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 output)
    list(GET pair 1 input)
    file(READ "${ORT_DIR}/${output}" actual)
    if(NOT actual STREQUAL "fixture: ${input}")
        message(FATAL_ERROR "NuGet layout adaptation lost ${output}")
    endif()
endforeach()
# A configured build must continue to work without another package download.
file(REMOVE "${CMAKE_BINARY_DIR}/fixture.nupkg")
include("${CMAKE_BINARY_DIR}/setup.cmake")
message(STATUS "ONNX Runtime NuGet layout, licenses and cache reuse passed")
