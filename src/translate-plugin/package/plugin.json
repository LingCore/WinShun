{
  "manifest": 1,
  "id": "winshun.translate",
  "name": {"zh": "翻译", "en": "Translate"},
  "version": "2.0.0",
  "description": {"zh": "tr 句子：中英互译，用你自己的 DeepL 或 OpenAI 兼容接口（在设置里填密钥；不填不联网）", "en": "tr sentence: translates with your own DeepL or OpenAI-compatible API (key in the settings; nothing is sent without one)"},
  "author": "LingCore",
  "homepage": "https://github.com/LingCore/WinShun",
  "license": "MIT",
  "runtime": {"mode": "resident", "program": "WinShunTranslate.exe", "timeoutMs": 10000, "idleExitSec": 900, "debounceMs": 300},
  "permissions": ["network"],
  "commands": [{
    "id": "tr",
    "keyword": ["tr", "fy"],
    "title": {"zh": "翻译", "en": "Translate"},
    "description": {"zh": "中文译成英文，其他译成中文", "en": "Chinese to English, anything else to Chinese"},
    "icon": "glyph:U+E8C1",
    "hint": {"zh": "要翻译的句子", "en": "a sentence to translate"},
    "cache": {"seconds": 300},
    "ai": {"description": "Translate a sentence with the user's configured translation API: Chinese to English, other languages to Chinese. The first item's title is the translation; when no API is configured the item says so."}
  }],
  "settings": [
    {"key": "provider", "type": "choice", "title": {"zh": "翻译服务", "en": "Service"}, "options": [
      {"value": "none", "title": {"zh": "未设置", "en": "Not set"}},
      {"value": "deepl", "title": "DeepL"},
      {"value": "openai", "title": {"zh": "OpenAI 兼容", "en": "OpenAI-compatible"}}
    ], "default": "none"},
    {"key": "apiKey", "type": "password", "title": {"zh": "API 密钥", "en": "API key"}, "hint": {"zh": "存在 Windows 凭据管理器里，不进设置文件", "en": "Kept in Windows Credential Manager, not in the settings file"}},
    {"key": "endpoint", "type": "text", "title": {"zh": "接口地址", "en": "Endpoint"}, "hint": {"zh": "OpenAI 兼容：如 https://api.openai.com/v1（DeepL 留空，按密钥自动选）", "en": "OpenAI-compatible: e.g. https://api.openai.com/v1 (DeepL: leave empty)"}, "default": ""},
    {"key": "model", "type": "text", "title": {"zh": "模型", "en": "Model"}, "hint": {"zh": "OpenAI 兼容接口用，如 gpt-4o-mini", "en": "For OpenAI-compatible endpoints, e.g. gpt-4o-mini"}, "default": "gpt-4o-mini"},
    {"key": "target", "type": "choice", "title": {"zh": "译成", "en": "Target"}, "options": [
      {"value": "auto", "title": {"zh": "自动（中⇄英）", "en": "Auto (zh ⇄ en)"}},
      {"value": "zh", "title": {"zh": "中文", "en": "Chinese"}},
      {"value": "en", "title": {"zh": "英文", "en": "English"}},
      {"value": "ja", "title": {"zh": "日文", "en": "Japanese"}}
    ], "default": "auto"}
  ],
  "ai": {"expose": true}
}
